# RozgaarLink Environment Variables

# Google Gemini API Key for AI translations
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (optional, defaults to 8080 or port assigned by Render)
PORT=8080

# Optional: Firebase Service Account JSON (as a single-line string for Cloud hosts like Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
